{
  "name": "lines-and-arrows",
  "version": "0.1.0",
  "description": "A lightweight sequence diagram language, SVG viewer, and visual editor.",
  "homepage": "https://lines-and-arrows.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apurin/lines-and-arrows.git"
  },
  "type": "module",
  "sideEffects": [
    "./src/auto.js",
    "./dist/lines-and-arrows.auto.min.js"
  ],
  "jsdelivr": "./dist/lines-and-arrows.auto.min.js",
  "unpkg": "./dist/lines-and-arrows.auto.min.js",
  "bin": {
    "lines-and-arrows": "bin/lines-and-arrows.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./syntax": {
      "types": "./src/syntax.d.ts",
      "import": "./src/syntax.js"
    },
    "./element": {
      "types": "./src/element.d.ts",
      "import": "./src/element.js"
    },
    "./auto": {
      "types": "./src/auto.d.ts",
      "import": "./src/auto.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "agents.md",
    "LICENSE",
    "README.md",
    "SKILL.md",
    "THIRD_PARTY_NOTICES.md",
    "syntax.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test",
    "check": "npm test && npm run build",
    "prepack": "npm run build",
    "validate": "node ./bin/lines-and-arrows.js validate"
  },
  "keywords": [
    "sequence-diagram",
    "svg",
    "diagram",
    "visualization"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
